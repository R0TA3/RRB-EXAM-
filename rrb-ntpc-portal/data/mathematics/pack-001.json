   "q": {
    "en": "Find the simple interest on ₹5000 at 8% per annum for 3 years.",
    "ml": "₹5000-ന് പ്രതിവർഷം 8% നിരക്കിൽ 3 വർഷത്തേക്കുള്ള സാധാരണ പലിശ കണ്ടെത്തുക."
   },
   "options": {
    "en": [
     "₹1000",
     "₹1200",
     "₹1400",
     "₹1500"
    ],
    "ml": [
     "₹1000",
     "₹1200",
     "₹1400",
     "₹1500"
    ]
   },
   "answer": 1,
   "explanation": {
    "en": "SI = PRT/100 = 5000 × 8 × 3 / 100 = ₹1200.",
    "ml": "SI = PRT/100 = 5000 × 8 × 3 / 100 = ₹1200."
   }
