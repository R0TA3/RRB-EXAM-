   "q": {
    "en": "A man walks 5 km north, then 3 km east, then 5 km south. How far is he from the start?",
    "ml": "ഒരാൾ 5 കി.മീ. വടക്ക്, പിന്നെ 3 കി.മീ. കിഴക്ക്, പിന്നെ 5 കി.മീ. തെക്ക് നടന്നു. തുടക്കത്തിൽ നിന്ന് എത്ര അകലെയാണ്?"
   },
   "options": {
    "en": [
     "3 km",
     "5 km",
     "8 km",
     "13 km"
    ],
    "ml": [
     "3 കി.മീ.",
     "5 കി.മീ.",
     "8 കി.മീ.",
     "13 കി.മീ."
    ]
   },
   "answer": 0,
   "explanation": {
    "en": "North and south cancel; only 3 km east remains.",
    "ml": "വടക്കും തെക്കും റദ്ദാകും; 3 കി.മീ. കിഴക്ക് മാത്രം ബാക്കി."
   }
